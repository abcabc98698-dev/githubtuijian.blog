---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { PRIMARY_AIRPORT, AIRPORTS } from '../../data/airports';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '机场推荐', href: '/jichang' },
];

const featuredAirports = AIRPORTS.slice(0, 6);
---

<BaseLayout
  title="2026高速稳定机场推荐：42家IEPL/BGP专线机场横向实测排行榜"
  description="收录2026年42家主流网络加速机场，基于晚高峰真实测速、IEPL内网专线稳定性、AI与4K流媒体解锁能力进行多维深度评测。提供不限时套餐、优惠码及新手避坑指南。"
  canonicalUrl="https://githubtuijian.blog/jichang/"
>
  <Header slot="header" />

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="mt-6 space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-500">
        <span>✈️ 2026 晚高峰实测严选</span>
      </div>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl md:text-5xl">
        2026 高速稳定专线机场推荐与横向综合评测
      </h1>
      <p class="max-w-4xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
        拒绝盲目跟风，告别晚高峰卡顿。我们历时 6 个月对全网 42 家主流网络加速机场展开深度真机测速，从 IEPL 物理专线架构、双 ISP 住宅 IP 解锁率、丢包率及历史运营年限多维量化，为您呈现真正可靠的机场选型指南。
      </p>
    </header>

    <!-- Selection Criteria 3 Pillars -->
    <section class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold">
          01
        </div>
        <h2 class="mt-4 text-lg font-bold text-[var(--text-primary)]">全内网 IEPL 专线</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          数据走国内物理光缆直达海外机房，不经公网 GFW 审查。晚高峰丢包率通常低于 0.1%，不受国际出口拥堵影响，适合游戏联机与 4K 超清直播。
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold">
          02
        </div>
        <h2 class="mt-4 text-lg font-bold text-[var(--text-primary)]">原生双 ISP 住宅 IP 落地</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          针对 OpenAI ChatGPT、Claude、Netflix 等严苛风控平台，优质机场在出口端部署纯净原生家庭宽带 IP，欺诈值极低，杜绝 1020 阻断。
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold">
          03
        </div>
        <h2 class="mt-4 text-lg font-bold text-[var(--text-primary)]">拒绝低价年付超售陷阱</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
          远离十几元包年的小作坊机场。优先选择提供月付、季付或真实大容量不限时套餐的成熟品牌，确保线路具有持续维护与技术扩容预算。
        </p>
      </div>
    </section>

    <!-- Flagship Spotlight -->
    <section class="mt-12 rounded-3xl border border-indigo-500/30 bg-gradient-to-br from-indigo-950/40 via-[var(--bg-secondary)] to-[var(--bg)] p-6 md:p-10 shadow-xl">
      <div class="flex flex-col lg:flex-row gap-8 items-start justify-between">
        <div class="space-y-4 max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-indigo-500/20 px-3 py-1 text-xs font-bold text-indigo-400 border border-indigo-500/30">
            ★ 2026 年度综合实力第 1 名
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
            光速云 — 旗舰高性价比专线首选
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            全内网 IEPL 专线，多入口智能负载均衡，晚高峰实测下行最高 <strong>529Mbps</strong>。独创 <strong>¥147 永久不限时套餐</strong>（200G 永久有效，适合备用与低频用户），同时拥有年付 99 高性价比主力方案与定制大带宽。
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-center text-xs">
            <div class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-2.5">
              <div class="text-amber-500 font-bold">¥147</div>
              <div class="text-[var(--text-tertiary)] mt-0.5">永久不过期包</div>
            </div>
            <div class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-2.5">
              <div class="text-indigo-500 font-bold">¥99/年</div>
              <div class="text-[var(--text-tertiary)] mt-0.5">1200G 超值主力</div>
            </div>
            <div class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-2.5">
              <div class="text-emerald-500 font-bold">&lt; 0.1%</div>
              <div class="text-[var(--text-tertiary)] mt-0.5">晚高峰丢包率</div>
            </div>
            <div class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-2.5">
              <div class="text-purple-500 font-bold">8 折优惠</div>
              <div class="text-[var(--text-tertiary)] mt-0.5">折扣码 AMM</div>
            </div>
          </div>
        </div>

        <div class="w-full lg:w-80 rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-5 shadow-lg space-y-4">
          <div class="text-xs font-bold text-[var(--text-tertiary)] uppercase tracking-wider text-center">
            EXCLUSIVE DISCOUNT CODE
          </div>
          <div class="rounded-xl border border-dashed border-amber-500/40 bg-amber-500/5 p-3 text-center">
            <div class="text-xs text-[var(--text-secondary)]">全场通用专属 8 折优惠券</div>
            <div class="text-xl font-mono font-extrabold text-amber-500 mt-1">AMM</div>
          </div>
          <a
            href={PRIMARY_AIRPORT.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="block w-full rounded-xl bg-indigo-600 py-3 text-center text-sm font-bold text-white shadow-lg shadow-indigo-600/30 transition-all hover:bg-indigo-700"
          >
            直达光速云官网特惠购 →
          </a>
          <a
            href="/airports/guangsu"
            class="block text-center text-xs text-indigo-500 hover:underline"
          >
            查看光速云完整测速报告与架构评测 »
          </a>
        </div>
      </div>
    </section>

    <!-- Top Featured Airports Grid -->
    <section class="mt-12 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
          精选高品质机场名录
        </h2>
        <a href="/brands" class="text-sm font-semibold text-indigo-500 hover:underline">
          查看全部 42 家机场品牌库 →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredAirports.map((airport) => (
          <div class="flex flex-col justify-between rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-5 shadow-sm transition-all hover:border-indigo-500/40 hover:shadow-md">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-lg bg-indigo-500/10 px-2.5 py-1 text-xs font-bold text-indigo-600 dark:text-indigo-400">
                  {airport.lineType}
                </span>
                <span class="text-xs text-[var(--text-tertiary)]">
                  {airport.founded}年创立
                </span>
              </div>
              <h3 class="mt-3 text-lg font-bold text-[var(--text-primary)]">
                {airport.name}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)] line-clamp-3">
                {airport.description}
              </p>
            </div>

            <div class="mt-5 border-t border-[var(--border)] pt-4 flex items-center justify-between">
              <div>
                <span class="text-xs text-[var(--text-tertiary)]">起始价格</span>
                <div class="text-sm font-bold text-[var(--text-primary)]">{airport.priceStarting}</div>
              </div>
              <a
                href={`/airports/${airport.slug}`}
                class="rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] px-3 py-1.5 text-xs font-semibold text-[var(--text-primary)] hover:border-indigo-500"
              >
                评测详情
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal Navigation Hub Links -->
    <section class="mt-12 border-t border-[var(--border)] pt-8">
      <h2 class="font-display text-xl font-bold text-[var(--text-primary)]">
        相关专线加速专题导航
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
        <a href="/brands" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">🏛️ 品牌库大厅</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">42 家机场品牌多维筛选与优惠码检索</p>
        </a>
        <a href="/nodes" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">🌐 高速节点</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">全球节点延迟对比与原生IP解锁</p>
        </a>
        <a href="/tizi" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">🪜 梯子推荐</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">抗封锁与敏感期备用梯子方案</p>
        </a>
        <a href="/alert" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-red-500">
          <div class="text-sm font-bold text-red-500">⚠️ 跑路预警雷达</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">倒闭跑路特征模型与资金避险指南</p>
        </a>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
