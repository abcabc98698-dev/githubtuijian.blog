---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '使用教程', href: '/tutorial' },
];

const tutorialGuides = [
  {
    os: 'Windows 电脑端教程',
    tool: 'Clash Verge Rev / v2rayN',
    desc: '系统环境要求 Windows 10/11。支持一键导入订阅、启用 TUN 虚拟网卡接管游戏与 CMD 终端。',
    href: '/clients/windows',
    tag: '电脑必备',
  },
  {
    os: 'iOS / iPhone 手机教程',
    tool: 'Shadowrocket (小火箭) / Stash',
    desc: '使用非国区 Apple ID 获取正版客户端。支持扫码导入订阅、规则分流与 MitM 证书解密。',
    href: '/clients/ios',
    tag: '苹果手机',
  },
  {
    os: 'Android 安卓手机教程',
    tool: 'v2rayNG / FlClash / Hiddify',
    desc: '国内各品牌安卓手机（华为/小米/OPPO/vivo）无障碍安装、省电白名单设置及分应用代理配置。',
    href: '/clients/android',
    tag: '安卓手机',
  },
  {
    os: 'macOS 苹果电脑教程',
    tool: 'Clash Verge Rev for Mac',
    desc: 'M1/M2/M3/M4 Apple Silicon 芯片与 Intel 架构双版本。支持权限赋予与系统级透明代理。',
    href: '/clients/macos',
    tag: 'Mac电脑',
  },
  {
    os: 'OpenWrt 软路由教程',
    tool: 'OpenClash / PassWall2 / Nikki',
    desc: '路由器刷机插件配置，实现 PS5、Switch、Apple TV、智能家居全屋无感翻墙与 DNS 防泄漏。',
    href: '/clients/openwrt',
    tag: '全屋无感',
  },
  {
    os: 'Linux 桌面与服务器教程',
    tool: 'AppImage GUI / mihomo CLI 守护进程',
    desc: 'Ubuntu、Debian、Arch Linux 终端代理配置、环境变量设置与 systemd 守护服务集成。',
    href: '/clients/linux',
    tag: '开发环境',
  },
];
---

<BaseLayout
  title="全平台科学上网使用教程：Windows/Mac/iOS/安卓/软路由保姆级配置"
  description="2026最新全操作系统科学上网与代理客户端使用教程。从客户端下载、订阅链接解析、TUN虚拟网卡设置到多节点分流策略，手把手图文指导零基础用户快速上手。"
  canonicalUrl="https://githubtuijian.blog/tutorial/"
>
  <Header slot="header" />

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="mt-6 space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-500">
        <span>📖 2026 全平台保姆级翻墙实操</span>
      </div>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl md:text-5xl">
        全平台科学上网与代理客户端保姆级使用教程
      </h1>
      <p class="max-w-4xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg">
        无论您使用的是 Windows 电脑、iPhone 手机、安卓设备、MacBook 还是家庭软路由，我们均为您准备了详尽、步骤直观的保姆级配置图文教程。拒绝繁复代码，3 步快速建立高速稳定的跨境网络连接。
      </p>
    </header>

    <!-- 3 Steps Quick Start Guide -->
    <section class="mt-10 rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 md:p-8 space-y-6">
      <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
        一、通用 3 步快速上手流程（适用于所有平台）
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] p-5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white font-bold text-sm">
            1
          </div>
          <h3 class="mt-3 font-bold text-[var(--text-primary)]">获取机场专属订阅链接</h3>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">
            登录您购买的机场后台（如 <a href="/airports/guangsu" class="text-indigo-500 underline font-medium">光速云</a>），在仪表盘找到“一键导入订阅”或复制通用 Clash/V2Ray 订阅链接。
          </p>
        </div>

        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] p-5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white font-bold text-sm">
            2
          </div>
          <h3 class="mt-3 font-bold text-[var(--text-primary)]">导入并下载节点配置</h3>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">
            打开对应平台的客户端（如 Clash Verge Rev、v2rayNG、Shadowrocket），粘贴链接并点击“保存并更新”，节点列表将自动拉取呈现。
          </p>
        </div>

        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] p-5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white font-bold text-sm">
            3
          </div>
          <h3 class="mt-3 font-bold text-[var(--text-primary)]">开启系统代理 / TUN 模式</h3>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">
            在代理策略组中勾选延时最低的节点，打开“系统代理”开关（进阶用户建议开启 TUN 虚拟网卡模式），即可打开 Google、YouTube 畅享高速上网。
          </p>
        </div>
      </div>
    </section>

    <!-- Platform Tutorial Cards -->
    <section class="mt-12 space-y-6">
      <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
        二、选择您的设备操作系统进入专属保姆级教程
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tutorialGuides.map((guide) => (
          <div class="flex flex-col justify-between rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 shadow-sm transition-all hover:border-indigo-500/50 hover:shadow-md">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-lg bg-indigo-500/10 px-2.5 py-1 text-xs font-bold text-indigo-600 dark:text-indigo-400">
                  {guide.tag}
                </span>
                <span class="text-xs text-[var(--text-tertiary)]">{guide.tool}</span>
              </div>
              <h3 class="mt-4 text-lg font-bold text-[var(--text-primary)]">
                {guide.os}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[var(--text-secondary)]">
                {guide.desc}
              </p>
            </div>

            <div class="mt-6 border-t border-[var(--border)] pt-4">
              <a
                href={guide.href}
                class="block w-full rounded-xl bg-indigo-600 py-2.5 text-center text-xs font-bold text-white shadow-md transition-colors hover:bg-indigo-700"
              >
                查看完整图文安装教程 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Internal Navigation Hub Links -->
    <section class="mt-12 border-t border-[var(--border)] pt-8">
      <h2 class="font-display text-xl font-bold text-[var(--text-primary)]">
        相关客户端与常见问答导航
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
        <a href="/clients" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">💻 客户端下载大厅</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">全平台官方开源纯净安装包汇集</p>
        </a>
        <a href="/clash" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">⚡ Clash 客户端</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">全平台客户端下载与保姆级订阅配置</p>
        </a>
        <a href="/faq" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">📖 技术百科 FAQ</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">60+ 核心技术全科问答与疑难解惑</p>
        </a>
        <a href="/jichang" class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 transition-all hover:border-indigo-500">
          <div class="text-sm font-bold text-[var(--text-primary)]">✈️ 机场推荐</div>
          <p class="mt-1 text-xs text-[var(--text-secondary)]">42 家主流专线机场实测与选型指南</p>
        </a>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
