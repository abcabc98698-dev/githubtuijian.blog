---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HeroSection from '../../components/marketing/HeroSection.astro';
import LogoCloud from '../../components/marketing/LogoCloud.astro';
import BentoGrid from '../../components/marketing/BentoGrid.astro';
import FaqAccordion from '../../components/marketing/FaqAccordion.astro';
import { SITE, getSiteBaseUrl } from '../../config/site';

const siteUrl = getSiteBaseUrl(Astro.site);
---

<BaseLayout
  title={`${SITE.name} - Arquitectura Web y Código Abierto de Alto Rendimiento`}
  description="Proyectos de código abierto seleccionados, herramientas para desarrolladores y optimización SEO técnica. Lighthouse 100/100."
  appendSiteName={false}
>
  <Fragment slot="head">
    <JsonLd
      type="WebSite"
      data={{
        name: SITE.name,
        url: siteUrl,
        description:
          'Plataforma independiente dedicada a la curación de proyectos de código abierto y arquitecturas web de alto rendimiento.',
        searchUrl: `${siteUrl}/search`,
      }}
    />
    <JsonLd
      type="Organization"
      data={{
        name: SITE.name,
        url: siteUrl,
        description:
          'Proyectos de código abierto seleccionados y arquitectura web de alto rendimiento.',
      }}
    />
  </Fragment>
  <Header slot="header" />

  <HeroSection
    badge="Código Abierto Seleccionado"
    titleStart="Descubre Proyectos"
    titleHighlight="De Alto Rendimiento"
    description="Análisis técnico de arquitecturas, herramientas para desarrolladores y benchmarks de rendimiento web. Lighthouse 100/100."
    primaryCtaText="Explorar Aeropuertos"
    primaryCtaHref="/airports"
    primaryCtaAriaLabel="Explorar Aeropuertos"
    secondaryCtaText="Centro de Clientes"
    secondaryCtaHref="/clients"
  />

  <LogoCloud
    title="Con la confianza de equipos innovadores"
    logos={[
      {
        name: 'Vercel',
        src: '/logos/vercel.svg',
        className: 'dark:invert',
      },
      {
        name: 'Astro',
        src: '/logos/astro-dark.svg',
        darkSrc: '/logos/astro-light.svg',
      },
      {
        name: 'Tailwind',
        src: '/logos/tailwind.svg',
      },
      { name: 'React', src: '/logos/react.svg' },
    ]}
  />

  <BentoGrid
    title="Todo lo que necesitas para posicionar mejor"
    subtitle="Construido desde cero para SEO técnico y motores de búsqueda con IA."
    items={[
      {
        title: 'Zero-JS por Defecto',
        description:
          'Envía menos JavaScript y consigue puntuaciones perfectas de 100/100 en Lighthouse. React solo se carga para islas interactivas cuando es estrictamente necesario.',
        colSpan: 2,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>',
      },
      {
        title: 'JSON-LD Automático',
        description:
          'Generación dinámica de datos estructurados de Schema.org para Artículos, FAQs, Organizaciones y Migas de Pan.',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>',
      },
      {
        title: 'Listo para GEO y AEO',
        description:
          'Estructuras de contenido optimizadas y HTML semántico diseñado para IA generativa y fragmentos destacados.',
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>',
      },
      {
        title: 'Soporte i18n Nativo',
        description: 'Soporte de primer nivel para múltiples idiomas con etiquetas hreflang automáticas.',
        colSpan: 2,
        icon: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>',
      },
    ]}
  />

  <FaqAccordion
    title="Preguntas Frecuentes"
    faqs={[
      {
        question: '¿GitHubTuijian es realmente gratuito?',
        answer:
          '¡Sí! Es 100% de código abierto bajo la licencia MIT. Puedes usarlo para proyectos personales y comerciales sin ninguna restricción.',
      },
      {
        question: '¿Necesito saber React para usar esta plataforma?',
        answer:
          'Para nada. Todo el núcleo está construido con Astro y HTML/CSS estándar. React solo se utiliza para componentes con interacción rica mediante Astro Islands.',
      },
      {
        question: '¿Cómo se genera el JSON-LD?',
        answer:
          'Utilizamos componentes Astro personalizados que leen los datos estructurados y generan scripts Schema.org JSON-LD válidos en el `<head>`, lo que ayuda a los motores de búsqueda a entender el contenido inmediatamente.',
      },
      {
        question: '¿Puedo desplegar esto en Vercel o Netlify?',
        answer:
          'Totalmente. Astro compila a HTML/CSS estático (SSG) de forma predeterminada, por lo que puedes desplegarlo en cualquier proveedor de alojamiento estático sin problemas.',
      },
    ]}
  />

  <Footer slot="footer" />
</BaseLayout>
