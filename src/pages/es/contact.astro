---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ContactForm from '../../components/marketing/ContactForm.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { SITE, getSiteBaseUrl } from '../../config/site';

const siteUrl = getSiteBaseUrl(Astro.site);
---

<BaseLayout
  title="Contacto"
  description="Ponte en contacto con el equipo de GitHubTuijian para recomendaciones de proyectos de código abierto, colaboraciones o consultas."
>
  <Fragment slot="head">
    <JsonLd
      type="Organization"
      data={{
        name: SITE.name,
        url: siteUrl,
        logo: `${siteUrl}/favicon.svg`,
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'technical support',
          email: SITE.contact.email,
          availableLanguage: ['English', 'Spanish', 'Chinese'],
        },
      }}
    />
  </Fragment>

  <Header slot="header" />

  <main class="mx-auto max-w-7xl px-6 py-20 md:py-32">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <!-- Contact Info (Left) -->
      <div>
        <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
          Conectemos
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--text-secondary)]">
          ¿Tienes un proyecto de red o proxy que te gustaría que revisemos, o te interesa colaborar en benchmarks de observabilidad técnica? Nuestro equipo está listo para ayudarte.
        </p>

        <dl class="mt-12 space-y-8">
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)]">
              Email
            </dt>
            <dd class="mt-2 text-lg text-[var(--text-secondary)]">
              <a
                href={`mailto:${SITE.contact.email}`}
                class="hover:text-[var(--color-primary-600)] dark:hover:text-[var(--color-primary-400)] transition-colors font-mono"
              >
                {SITE.contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)]">
              Telegram
            </dt>
            <dd class="mt-2 text-lg text-[var(--text-secondary)]">
              <a
                href={SITE.contact.telegram}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-[var(--color-primary-600)] dark:hover:text-[var(--color-primary-400)] transition-colors font-mono"
              >
                {SITE.contact.telegram}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)]">
              Comunidad
            </dt>
            <dd class="mt-2 text-lg leading-relaxed text-[var(--text-secondary)]">
              {SITE.contact.address}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Contact Form (Right) -->
      <div class="rounded-3xl border border-[var(--border)] bg-[var(--bg)] p-8 shadow-sm sm:p-10">
        <h2 class="mb-8 font-display text-2xl font-bold text-[var(--text-primary)]">
          Enviar mensaje
        </h2>
        <ContactForm />
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
