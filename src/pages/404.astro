---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="404 - 页面未找到"
  description="抱歉，您访问的页面不存在或已被移除。"
  noindex={true}
>
  <Header slot="header" />

  <main class="flex min-h-[70vh] flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-base font-semibold text-indigo-600 dark:text-indigo-400">
      404 NOT FOUND
    </p>
    <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
      页面未找到
    </h1>
    <p class="mt-6 text-base text-[var(--text-secondary)]">
      抱歉，您访问的页面不存在、已被移除或链接输入有误。
    </p>
    <div class="mt-10 flex flex-wrap gap-4 justify-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 transition-all hover:-translate-y-0.5 hover:bg-indigo-700 hover:shadow-xl"
      >
        返回网站首页
      </a>
      <a
        href="/brands"
        class="inline-flex items-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] px-6 py-3 text-sm font-semibold text-[var(--text-primary)] transition-all hover:bg-[var(--border)]"
      >
        浏览 42 家机场品牌库
      </a>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
