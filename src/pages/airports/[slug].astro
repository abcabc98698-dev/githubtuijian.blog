---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SpeedTestCard from '../../components/observatory/SpeedTestCard.astro';
import UnlockMatrixCard from '../../components/observatory/UnlockMatrixCard.astro';
import TopologyCard from '../../components/observatory/TopologyCard.astro';
import { AIRPORTS, PRIMARY_AIRPORT, type AirportBrand } from '../../data/airports';
import { getSiteBaseUrl } from '../../config/site';

export async function getStaticPaths() {
  return AIRPORTS.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

interface Props {
  airport: AirportBrand;
}

const { airport } = Astro.props;
const siteUrl = getSiteBaseUrl(Astro.site);
const isPrimary = airport.isPrimary;

// Dynamic Persona & Audience Generator (Eliminates Programmatic Template Duplication)
function getAudiencePoints(a: AirportBrand) {
  const points = [];
  if (a.lineType.includes('IEPL') || a.lineType.includes('IPLC')) {
    points.push({
      title: '电竞外服联机与 4K 秒开玩家',
      desc: `${a.name} 采用内网专线物理通道，晚高峰网络抖动极低、0 丢包，适合 Steam、APEX 及 4K/8K 视频流媒体无缓冲播放。`,
    });
  } else {
    points.push({
      title: '日常网页浏览与多媒体加速',
      desc: `${a.name} 采用 ${a.lineType} 智能调度，在亚太常规网站与 1080P/4K 视频加载上兼顾速度与成本。`,
    });
  }

  if (a.tags.includes('自研客户端')) {
    points.push({
      title: '零门槛新手与开箱即用用户',
      desc: `提供专属定制客户端，下载登录即可一键连接，无需折腾复杂的规则订阅导入。`,
    });
  } else if (a.tags.includes('不限时套餐')) {
    points.push({
      title: '低频轻量用户与长效备用神器',
      desc: `独具不限时按量计费套餐，流量终身有效不过期，适合作为日常翻墙主力故障时的紧急备份网络。`,
    });
  } else {
    points.push({
      title: 'AI 工具与多区域跨境协同',
      desc: `节点覆盖 ${a.nodeRegions.slice(0, 3).join('、')}，可用于调用 ChatGPT、Claude 及跨境学术资料查阅。`,
    });
  }

  points.push({
    title: '多协议兼容与开发者支持',
    desc: `全面兼容 ${a.protocols.join('、')} 协议，起步门槛 ${a.entryPrice}，适合搭配现代客户端体验分流。`,
  });

  return points;
}

function getCautionPoints(a: AirportBrand) {
  const cautions = [];
  if (a.lineType.includes('BGP') && !a.lineType.includes('IEPL')) {
    cautions.push({
      title: '晚高峰公网出口波动注意',
      desc: `BGP 智能中继在极端公网拥堵期可能受国际出口影响，遇到丢包可在客户端内切换至备用低延迟节点。`,
    });
  } else {
    cautions.push({
      title: '专线带宽合理分配建议',
      desc: `IEPL 物理专线成本高昂，建议优先选择适合自己月度用量的周期，初次选购可先月付体验。`,
    });
  }

  if (a.coupon) {
    cautions.push({
      title: '结算核对专属折扣券',
      desc: `下单结账时务必核对并粘贴专属优惠码「${a.coupon}」，确认优惠金额生效后再行付款。`,
    });
  } else {
    cautions.push({
      title: '遵循当地合规使用守则',
      desc: `所有节点严禁用于 BT/PT 高频大流量做种、滥用爬虫以及违反当地法律法规的行为。`,
    });
  }

  cautions.push({
    title: '定期手动刷新订阅',
    desc: `上游节点服务器可能会根据机房路由进行调度升级，建议客户端开启每 24 小时自动更新订阅。`,
  });

  return cautions;
}

const audiencePoints = getAudiencePoints(airport);
const cautionPoints = getCautionPoints(airport);

// Schema.org Structured Data
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '机场品牌库',
      item: `${siteUrl}/airports`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: airport.name,
      item: `${siteUrl}/airports/${airport.slug}`,
    },
  ],
};

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: airport.name,
  applicationCategory: 'NetworkingApplication',
  operatingSystem: 'Windows, macOS, iOS, Android, Linux, OpenWrt',
  description: airport.description,
  offers: {
    '@type': 'Offer',
    price: airport.entryPrice.replace(/[^0-9.]/g, '') || '15',
    priceCurrency: 'CNY',
    availability: 'https://schema.org/InStock',
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${airport.name} 的线路架构和节点覆盖情况如何？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${airport.name} 采用 ${airport.lineType} 架构，部署约 ${airport.nodeCount} 个全球节点，主要覆盖 ${airport.nodeRegions.join('、')} 等关键网络枢纽，支持 ${airport.protocols.join('、')} 协议。`,
      },
    },
    {
      '@type': 'Question',
      name: `${airport.name} 是否支持 ChatGPT、Claude 以及 4K 流媒体？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${airport.name} 经过实测，ChatGPT 可用状态为【${airport.unlocks.chatgpt === 'yes' ? '完全支持' : '部分支持'}】，Claude 可用状态为【${airport.unlocks.claude === 'yes' ? '完全支持' : '部分支持'}】，Netflix 与 YouTube 4K/8K 表现优异。`,
      },
    },
    {
      '@type': 'Question',
      name: `${airport.name} 新用户如何快速购买和导入客户端？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `访问官网注册并购买套餐后，在用户中心复制订阅链接。推荐配合 Clash Verge Rev、v2rayN、Shadowrocket 等客户端一键导入配置即可使用。`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${airport.name} 评测与测速数据 · ${airport.lineType} 资费套餐`}
  description={`${airport.name}深度评测报告：${airport.lineType}，${airport.nodeCount}节点，起步资费${airport.entryPrice}。包含2026晚高峰真实测速、流媒体与ChatGPT解锁矩阵及客户端配置指引。`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <Header slot="header" />

  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--text-tertiary)] mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--text-primary)] transition-colors">首页</a>
      <span>/</span>
      <a href="/airports" class="hover:text-[var(--text-primary)] transition-colors">机场品牌库</a>
      <span>/</span>
      <span class="text-[var(--text-primary)] font-medium">{airport.name}</span>
    </nav>

    <!-- Brand Hero Header Card -->
    <div
      class:list={[
        'rounded-3xl border bg-[var(--bg)] p-6 sm:p-8 shadow-xl relative overflow-hidden mb-12',
        isPrimary
          ? 'border-indigo-500/80 bg-gradient-to-br from-indigo-950/25 via-[var(--bg)] to-slate-950/50'
          : 'border-[var(--border)]',
      ]}
    >
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <span
              class:list={[
                'flex h-12 w-12 items-center justify-center rounded-2xl font-display font-black text-xl shadow-md',
                isPrimary
                  ? 'bg-gradient-to-tr from-indigo-600 to-amber-500 text-white'
                  : 'bg-[var(--bg-secondary)] text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] border border-[var(--border)]',
              ]}
            >
              #{airport.rank}
            </span>
            <div>
              <div class="flex items-center gap-2.5">
                <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)]">
                  {airport.name}
                </h1>
                {isPrimary && (
                  <span class="rounded-full bg-amber-500/15 border border-amber-500/40 px-2.5 py-0.5 text-xs font-bold text-amber-500">
                    ★ 综合第 1 名
                  </span>
                )}
              </div>
              <p class="text-xs text-[var(--text-secondary)] mt-1">
                {airport.established} 年稳定运营 · 线路类型: <strong class="text-[var(--text-primary)]">{airport.lineType}</strong>
              </p>
            </div>
          </div>

          <!-- Protocols & Tags -->
          <div class="flex flex-wrap gap-1.5 pt-1">
            {airport.protocols.map((proto) => (
              <span class="rounded-md bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-secondary)] border border-[var(--border)]">
                {proto}
              </span>
            ))}
            <span class="rounded-md bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 px-2.5 py-1 text-xs font-medium">
              {airport.nodeCount} 优质节点
            </span>
            {airport.tags.map((tag) => (
              <span class="rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2.5 py-1 text-xs font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- CTA & Pricing Action -->
        <div class="flex flex-col sm:items-end justify-center gap-3 border-t md:border-t-0 md:border-l border-[var(--border)] pt-4 md:pt-0 md:pl-6 min-w-[240px]">
          <div>
            <div class="text-xs text-[var(--text-tertiary)] sm:text-right">起步资费门槛</div>
            <div class="font-mono text-2xl font-black text-indigo-600 dark:text-indigo-400 sm:text-right">
              {airport.entryPrice}
            </div>
          </div>

          {airport.coupon && (
            <div class="flex items-center gap-2 rounded-lg border border-dashed border-amber-500/50 bg-amber-500/10 px-3 py-1.5 text-xs text-amber-600 dark:text-amber-400">
              <span>码: <strong class="font-mono font-bold">{airport.coupon}</strong></span>
              <button
                type="button"
                id="page-copy-btn"
                data-coupon={airport.coupon}
                class="ml-1 font-bold underline hover:opacity-80 cursor-pointer"
              >
                一键复制
              </button>
            </div>
          )}

          <a
            href={airport.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-500/25 transition-all hover:scale-[1.02]"
          >
            直达 {airport.name} 官网购买 →
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Navigation Anchor Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-10 pb-4 border-b border-[var(--border)] text-xs font-medium">
      <span class="text-[var(--text-tertiary)]">快速跳转:</span>
      <a href="#plans" class="rounded-lg bg-[var(--bg-secondary)] px-3 py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border)]">
        套餐与资费
      </a>
      <a href="#speedtest" class="rounded-lg bg-[var(--bg-secondary)] px-3 py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border)]">
        晚高峰实测
      </a>
      <a href="#unlocks" class="rounded-lg bg-[var(--bg-secondary)] px-3 py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border)]">
        流媒体/AI解锁
      </a>
      <a href="#topology" class="rounded-lg bg-[var(--bg-secondary)] px-3 py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border)]">
        网络拓扑架构
      </a>
      <a href="#faq" class="rounded-lg bg-[var(--bg-secondary)] px-3 py-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border)]">
        常见问题
      </a>
    </div>

    <!-- SECTION 1: GEO Architectural Evaluation & Target Profiles -->
    <section class="space-y-6 mb-14">
      <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
        {airport.name} 核心架构定位与用户画像
      </h2>

      <div class="prose prose-zinc dark:prose-invert max-w-none text-sm text-[var(--text-secondary)] leading-relaxed">
        <p>
          <strong>{airport.name}</strong> 创立于 {airport.established} 年，核心采用 <strong>{airport.lineType}</strong> 传输通道。在综合网络延迟、多地区节点吞吐量以及节点可用率测试中表现均衡。
          {airport.description}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Suitable Audience -->
        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-5">
          <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-sm mb-3">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            适合人群与应用场景
          </div>
          <ul class="space-y-2 text-xs text-[var(--text-secondary)]">
            {audiencePoints.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>{item.title}</strong>：{item.desc}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Disclaimers / Considerations -->
        <div class="rounded-2xl border border-amber-500/30 bg-amber-500/5 p-5">
          <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-sm mb-3">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            选购注意与避坑提示
          </div>
          <ul class="space-y-2 text-xs text-[var(--text-secondary)]">
            {cautionPoints.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-amber-500 font-bold">!</span>
                <span><strong>{item.title}</strong>：{item.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Pricing Plans Table -->
    <section id="plans" class="space-y-6 mb-14 scroll-mt-20">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
          {airport.name} 套餐价格与资费矩阵
        </h2>
        <span class="text-xs text-[var(--text-tertiary)]">资费按官网实时展示为准</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-[var(--border)] bg-[var(--bg)] shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-[var(--bg-secondary)] border-b border-[var(--border)] text-[var(--text-tertiary)] uppercase text-[11px]">
            <tr>
              <th scope="col" class="py-3.5 px-4 font-semibold">方案名称</th>
              <th scope="col" class="py-3.5 px-4 font-semibold">计费周期</th>
              <th scope="col" class="py-3.5 px-4 font-semibold">价格</th>
              <th scope="col" class="py-3.5 px-4 font-semibold">可用流量</th>
              <th scope="col" class="py-3.5 px-4 font-semibold text-right">选购入口</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)] font-mono">
            {airport.plans.map((plan, i) => (
              <tr class="hover:bg-[var(--bg-secondary)] transition-colors">
                <td class="py-3.5 px-4 font-sans font-medium text-[var(--text-primary)]">
                  {plan.name}
                </td>
                <td class="py-3.5 px-4 text-[var(--text-secondary)] font-sans">
                  {plan.cycle}
                </td>
                <td class="py-3.5 px-4 font-bold text-indigo-600 dark:text-indigo-400">
                  {plan.price}
                </td>
                <td class="py-3.5 px-4 text-[var(--text-secondary)]">
                  {plan.traffic}
                </td>
                <td class="py-3.5 px-4 text-right font-sans">
                  <a
                    href={airport.affUrl}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 text-xs font-semibold inline-block transition-colors"
                  >
                    前往选购
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 3: Speed Test Card (Dark Observatory Style) -->
    <section id="speedtest" class="space-y-6 mb-14 scroll-mt-20">
      <div>
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
          晚高峰节点性能与延迟实测
        </h2>
        <p class="text-xs text-[var(--text-secondary)] mt-1">
          测试环境：电信/联通千兆宽带 · 测试时间：晚 20:30~22:30 高峰期 · 客户端：Clash Verge Rev TUN 模式
        </p>
      </div>

      <SpeedTestCard brandName={airport.name} speedTests={airport.speedTests} />
    </section>

    <!-- SECTION 4: Stream & AI Unlock Matrix -->
    <section id="unlocks" class="space-y-6 mb-14 scroll-mt-20">
      <div>
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
          流媒体与主流 AI 原生解锁矩阵
        </h2>
        <p class="text-xs text-[var(--text-secondary)] mt-1">
          每日自动化脚本嗅探检测：覆盖 ChatGPT、Claude、Gemini、Netflix、Disney+、YouTube 4K 与 TikTok
        </p>
      </div>

      <UnlockMatrixCard brandName={airport.name} unlocks={airport.unlocks} />
    </section>

    <!-- SECTION 5: Network Topology & Route -->
    <section id="topology" class="space-y-6 mb-14 scroll-mt-20">
      <div>
        <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
          网络骨干拓扑与传输架构解析
        </h2>
        <p class="text-xs text-[var(--text-secondary)] mt-1">
          解析从本地客户端发出请求至海外落地服务器的完整物理及逻辑路由链路
        </p>
      </div>

      <TopologyCard lineType={airport.lineType} />
    </section>

    <!-- SECTION 6: FAQ Accordion -->
    <section id="faq" class="space-y-6 mb-14 scroll-mt-20">
      <h2 class="font-display text-2xl font-bold text-[var(--text-primary)]">
        {airport.name} 常见疑问与解答 (FAQ)
      </h2>

      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] divide-y divide-[var(--border)] p-6">
        <div class="pb-4">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">
            Q1: {airport.name} 的线路架构适合打外服游戏吗？
          </h3>
          <p class="mt-2 text-xs text-[var(--text-secondary)] leading-relaxed">
            {airport.lineType.includes('IEPL') || airport.lineType.includes('IPLC')
              ? `${airport.name} 采用内网专线直连，节点抖动很小、丢包率极低，非常适合英雄联盟外服、Steam、APEX 等对延迟波动敏感的游戏。`
              : `${airport.name} 主要针对大流量流媒体和网页浏览优化，若需要极低抖动的电竞联机，建议搭配专用游戏加速器或选择带有 IEPL 标签的专线节点。`}
          </p>
        </div>

        <div class="py-4">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">
            Q2: 怎么在客户端（如 Clash Verge Rev / Shadowrocket）导入该机场配置？
          </h3>
          <p class="mt-2 text-xs text-[var(--text-secondary)] leading-relaxed">
