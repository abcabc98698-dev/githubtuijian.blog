---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getAlternateLocales } from '../i18n/utils';
import { SITE, getSiteBaseUrl, buildCanonicalUrl, buildOgImageUrl } from '../config/site';

// Self-host Inter font for 100/100 PageSpeed Insights score
import '@fontsource-variable/inter';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  lang?: string;
  appendSiteName?: boolean;
}

const detectedLang = getLangFromUrl(Astro.url);

const {
  title,
  description,
  image = '/og-default.png',
  canonicalUrl,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  lang = detectedLang === 'en' ? 'zh-CN' : detectedLang,
  appendSiteName = true,
} = Astro.props;

const t = useTranslations(detectedLang);
const siteUrl = getSiteBaseUrl(Astro.site);
const currentUrl = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const siteName = SITE.name;
const fullTitle = appendSiteName ? `${title} | ${siteName}` : title;
const alternateLocales = getAlternateLocales(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Search Engine Robots Directive -->
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Search Engine Verifications (Google, Bing, Shenma, Baidu) -->
    {SITE.verifications.google && (
      <meta name="google-site-verification" content={SITE.verifications.google} />
    )}
    {SITE.verifications.bing && (
      <meta name="msvalidate.01" content={SITE.verifications.bing} />
    )}
    {SITE.verifications.shenma && (
      <meta name="shenma-site-verification" content={SITE.verifications.shenma} />
    )}
    {SITE.verifications.baidu && (
      <meta name="baidu-site-verification" content={SITE.verifications.baidu} />
    )}

    <!-- Canonical URL (Omitted on error/noindex pages per Google guidelines) -->
    {!noindex && <link rel="canonical" href={currentUrl} />}

    <!-- Hreflang tags for i18n (only output when alternate translations actually exist) -->
    {alternateLocales.length > 1 && alternateLocales.map(({ lang: altLang, href }) => (
      <link
        rel="alternate"
        hreflang={altLang === 'en' ? 'zh-CN' : 'es-ES'}
        href={new URL(href, siteUrl).toString()}
      />
    ))}
    {alternateLocales.length > 1 && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(alternateLocales[0].href, siteUrl).toString()}
      />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'zh_CN'} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- Dark Mode: Inline script to prevent FOUC -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (
          theme === 'dark' ||
          (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Slot for page-specific head content (JSON-LD, hreflang, etc.) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text-primary)] antialiased transition-colors duration-200">
    <!-- Skip to main content (a11y) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {t('skipToContent')}
    </a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
