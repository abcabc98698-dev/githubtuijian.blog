---
/**
 * AirportCard.astro — Unified Brand Directory Card
 * Dark Observatory Aesthetics with High-Conversion CTA
 */
import type { AirportBrand } from '../../data/airports';

interface Props {
  airport: AirportBrand;
}

const { airport } = Astro.props;

const isTop1 = airport.rank === 1;
---

<div
  class:list={[
    'airport-card group relative flex flex-col justify-between rounded-2xl border bg-[var(--bg)] p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl',
    isTop1
      ? 'border-indigo-500/80 ring-2 ring-indigo-500/20 bg-gradient-to-b from-indigo-950/20 to-[var(--bg)]'
      : 'border-[var(--border)] hover:border-indigo-500/50',
  ]}
  data-name={airport.name.toLowerCase()}
  data-slug={airport.slug}
  data-line={airport.lineType}
  data-tags={airport.tags.join(' ')}
  data-coupon={airport.coupon || ''}
  data-rank={airport.rank}
  data-established={airport.established}
  data-desc={airport.description.toLowerCase()}
>
  <div>
    <!-- Top Header & Badges -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <div
          class:list={[
            'flex h-11 w-11 items-center justify-center rounded-xl font-display font-black text-lg',
            isTop1
              ? 'bg-gradient-to-tr from-indigo-600 to-amber-500 text-white shadow-lg shadow-indigo-500/30'
              : 'bg-[var(--bg-secondary)] text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] border border-[var(--border)]',
          ]}
        >
          {airport.rank}
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-display text-xl font-bold text-[var(--text-primary)]">
              <a href={`/airports/${airport.slug}`} class="hover:text-[var(--color-primary-500)] transition-colors">
                {airport.name}
              </a>
            </h3>
            {isTop1 && (
              <span class="rounded-full bg-amber-500/15 border border-amber-500/40 px-2 py-0.5 text-[11px] font-bold text-amber-500">
                ★ 旗舰主推
              </span>
            )}
          </div>
          <p class="text-xs text-[var(--text-secondary)] mt-0.5">
            {airport.established} 年运营 · {airport.lineType}
          </p>
        </div>
      </div>

      <!-- Price Badge -->
      <div class="text-right">
        <div class="text-xs text-[var(--text-tertiary)]">入门起步</div>
        <div class="font-mono text-base font-extrabold text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]">
          {airport.entryPrice}
        </div>
      </div>
    </div>

    <!-- Tags & Badges -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {airport.protocols.map((proto) => (
        <span class="rounded-md bg-[var(--bg-secondary)] px-2 py-0.5 text-[11px] font-medium text-[var(--text-secondary)] border border-[var(--border)]">
          {proto}
        </span>
      ))}
      <span class="rounded-md bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 px-2 py-0.5 text-[11px] font-medium">
        {airport.nodeCount} 节点
      </span>
      {airport.tags.slice(0, 3).map((tag) => (
        <span class="rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 text-[11px] font-medium">
          {tag}
        </span>
      ))}
    </div>

    <!-- Description -->
    <p class="mt-4 line-clamp-2 text-xs leading-relaxed text-[var(--text-secondary)]">
      {airport.description}
    </p>

    <!-- Coupon Box (if any) -->
    {airport.coupon && (
      <div class="mt-4 flex items-center justify-between rounded-lg border border-dashed border-amber-500/40 bg-amber-500/5 px-3 py-2 text-xs">
        <span class="text-amber-600 dark:text-amber-400 font-medium">
          专属优惠码: <strong class="font-mono font-bold">{airport.coupon}</strong>
        </span>
        <button
          type="button"
          class="copy-btn text-xs font-semibold text-amber-600 dark:text-amber-300 hover:underline cursor-pointer"
          data-coupon={airport.coupon}
        >
          复制
        </button>
      </div>
    )}
  </div>

  <!-- Bottom CTA Actions -->
  <div class="mt-6 flex items-center gap-2 border-t border-[var(--border)] pt-4">
    <a
      href={`/airports/${airport.slug}`}
      class="flex-1 rounded-xl border border-[var(--border)] bg-[var(--bg-secondary)] px-3 py-2 text-center text-xs font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--border)]"
    >
      测速报告 & 详情
    </a>
    <a
      href={airport.affUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class:list={[
        'flex-1 rounded-xl px-3 py-2 text-center text-xs font-bold text-white transition-all shadow-sm',
        isTop1
          ? 'bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 shadow-indigo-500/25'
          : 'bg-indigo-600 hover:bg-indigo-700',
      ]}
    >
      直达官网 →
    </a>
  </div>
</div>
