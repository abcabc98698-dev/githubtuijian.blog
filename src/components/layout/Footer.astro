---
/**
 * Footer.astro — Site footer with SEO navigation columns and observatory aesthetics
 */
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { SITE } from '../../config/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: '核心专线栏目',
    links: [
      { label: '机场推荐大厅', href: '/jichang' },
      { label: 'VPN 深度横评', href: '/vpn' },
      { label: '梯子防封选型', href: '/tizi' },
      { label: '42 家品牌库', href: '/brands' },
      { label: '光速云 (旗舰首选)', href: '/airports/guangsu' },
    ],
  },
  {
    title: '客户端与教程',
    links: [
      { label: 'Clash 客户端中心', href: '/clash' },
      { label: '使用教程总览', href: '/tutorial' },
      { label: '全球高速节点对比', href: '/nodes' },
      { label: 'Windows 电脑配置', href: '/clients/windows' },
      { label: 'iOS 苹果小火箭教程', href: '/clients/ios' },
    ],
  },
  {
    title: '深度专题与避坑',
    links: [
      { label: '免费资源与应急方案', href: '/free' },
      { label: '万字免费应急节点', href: '/free-nodes' },
      { label: '⚠️ 跑路预警与防坑雷达', href: '/alert' },
      { label: '📖 机场技术百科 FAQ', href: '/faq' },
      { label: '商务合作与评测提交', href: '/contact' },
    ],
  },
];
---

<footer class="border-t border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a
          href="/"
          class="flex items-center gap-2 font-display text-lg font-bold"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-7 w-7 text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          <span class="font-display text-xl font-bold tracking-tight">
            GitHub
            <span class="text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]">
              Tuijian
            </span>
          </span>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-[var(--text-secondary)]">
          GitHub推荐 · 2026 全球高速专线网络测速实验室与全平台代理客户端落地中心。基于晚高峰真实测速、流媒体与 AI 原生解锁矩阵，提供客观透明的科学选型指南。
        </p>

        <!-- Status Pill -->
        <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          42 个节点探针实时监控中
        </div>
      </div>

      <!-- Navigation columns -->
      <h2 class="sr-only">页脚导航</h2>
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs sm:text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-xs text-[var(--text-tertiary)] md:flex-row">
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
        <p>
          &copy; {currentYear} {SITE.name} ({new URL(SITE.url).hostname}). 保留所有权利。
        </p>
        <div class="flex gap-4">
          <a
            href="/privacy"
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            隐私政策
          </a>
          <a
            href="/terms"
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            服务条款
          </a>
        </div>
      </div>
      <p>
        由 <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Astro</a> 极速驱动 · 纯净独立架构
      </p>
    </div>
  </div>
</footer>
