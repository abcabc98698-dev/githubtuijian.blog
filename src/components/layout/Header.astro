---
/**
 * Header.astro — Site header with navigation and dark mode toggle
 * Designed for Maximum SEO Crawlability & High Conversion
 */
import DarkModeToggle from '../ui/DarkModeToggle.astro';
import { PRIMARY_AIRPORT } from '../../data/airports';

const currentPath = Astro.url.pathname;

// All 8 Core Pillars as explicit crawler-friendly navigation links
const navLinks = [
  { label: '机场推荐', href: '/jichang' },
  { label: 'VPN', href: '/vpn' },
  { label: 'Clash', href: '/clash' },
  { label: '节点', href: '/nodes' },
  { label: '梯子', href: '/tizi' },
  { label: '免费资源', href: '/free' },
  { label: '使用教程', href: '/tutorial' },
  { label: '品牌库', href: '/brands' },
];

const secondaryLinks = [
  { label: '⚠️ 跑路预警', href: '/alert' },
  { label: '📖 技术百科', href: '/faq' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-lg">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-6">
    <!-- Brand Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight"
    >
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white shadow-md shadow-indigo-500/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
      </div>
      <span class="text-[var(--text-primary)]">
        GitHub
        <span class="text-indigo-600 dark:text-indigo-400">
          推荐
        </span>
      </span>
      <span class="hidden lg:inline-block rounded-full bg-indigo-500/10 px-2 py-0.5 text-[10px] font-semibold text-indigo-500 border border-indigo-500/20">
        42家机场精选
      </span>
    </a>

    <!-- Desktop Navigation: Direct HTML Anchors for 100% Crawlability -->
    <nav class="hidden xl:flex items-center gap-1" aria-label="Main navigation">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors',
            currentPath === item.href || currentPath.startsWith(item.href + '/')
              ? 'text-indigo-600 dark:text-indigo-400 bg-indigo-500/10 font-bold'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]',
          ]}
        >
          {item.label}
        </a>
      ))}

      <!-- Dropdown for Alert and FAQ -->
      <div class="group relative inline-block ml-1">
        <button
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
          aria-haspopup="true"
        >
          <span>专题</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="invisible absolute right-0 top-full pt-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 z-50">
          <div class="w-48 rounded-xl border border-[var(--border)] bg-[var(--bg)] p-2 shadow-xl backdrop-blur-xl space-y-1">
            {secondaryLinks.map((sub) => (
              <a
                href={sub.href}
                class="block rounded-lg px-3 py-2 text-xs font-semibold text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
              >
                {sub.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <!-- Compact desktop nav for md to lg screens -->
    <nav class="hidden md:flex xl:hidden items-center gap-1">
      <a href="/jichang" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">机场推荐</a>
      <a href="/vpn" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">VPN</a>
      <a href="/clash" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Clash</a>
      <a href="/nodes" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">节点</a>
      <a href="/tizi" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">梯子</a>
      <a href="/free" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">免费</a>
      <a href="/tutorial" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">教程</a>
      <a href="/brands" class="rounded-lg px-2 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">品牌库</a>
    </nav>

    <!-- Right side: CTA + Dark mode -->
    <div class="flex items-center gap-2 md:gap-3">
      <DarkModeToggle />

      <!-- Primary High-Conversion Button: 光速云 8折直达 -->
      <a
        href={PRIMARY_AIRPORT.affUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 px-3 py-1.5 text-xs font-bold text-white shadow-md shadow-indigo-500/25 transition-all hover:from-indigo-500 hover:to-indigo-600"
      >
        <span class="animate-pulse">🔥</span>
        <span>光速云 8折</span>
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-secondary)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-[var(--border)] px-4 py-4 md:hidden overflow-y-auto max-h-[calc(100vh-4rem)] bg-[var(--bg)]"
    aria-label="Mobile navigation"
  >
    <div class="space-y-2">
      <a
        href={PRIMARY_AIRPORT.affUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="block w-full rounded-xl bg-indigo-600 p-2.5 text-center text-xs font-bold text-white shadow-md"
      >
        🔥 光速云 8折直达 (优惠码 AMM)
      </a>

      <div class="grid grid-cols-2 gap-2 pt-2">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class="rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] p-2.5 text-center text-xs font-semibold text-[var(--text-primary)]"
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="border-t border-[var(--border)] pt-2 space-y-1">
        <a href="/alert" class="block py-1.5 px-3 text-xs text-red-500 font-semibold rounded-lg hover:bg-[var(--bg-secondary)]">
          ⚠️ 跑路预警与防坑雷达
        </a>
        <a href="/faq" class="block py-1.5 px-3 text-xs text-[var(--text-secondary)] font-semibold rounded-lg hover:bg-[var(--bg-secondary)]">
          📖 机场技术百科 FAQ
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
